include LICENSE README.md pyproject.toml
recursive-include firmavex *.py *.c *.ld *.md
recursive-include src/firmavex *.py
recursive-include firmware/benchmarks/cortex_m *.c *.ld *.md manifest.json
recursive-include docs/product *.md *.png
prune tests
recursive-include tests/product *.py
recursive-include tests/desktop *.py
global-exclude *.py[cod] *.elf *.ELF *.bin *.BIN *.exe *.EXE *.hex *.map
global-exclude *.sqlite *.sqlite3 *.db *.log
prune build
prune dist
prune .git
prune .venv
include tools/product_ci_tests.py

recursive-include packaging *.py *.spec *.iss *.ps1 *.md *.txt
include tools/desktop_distribution_manifest.py
include tools/desktop_native_evidence.py
include tools/desktop_runtime_probe.py
include tools/desktop_ci_demo.py

recursive-include firmavex/product/resources *.json

include packaging/FIRMAVEX.desktop packaging/signing-readiness.json
include tools/build_linux_deb.py tools/build_product_example_image.py
include tools/desktop_setup_ci.py

recursive-include firmavex/backends/examples *.S *.v
recursive-include tests/backends *.py

include tools/backend_qualification.py

recursive-include firmavex/backends/examples *.json

include tools/universal_desktop_ci.py
